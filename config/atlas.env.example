# Example only. NEVER put actual credentials into GitHub.
# For the local classroom pilot, leave Google variables unset.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8765
# If multiple network interfaces exist, set your actual classroom LAN origin:
# ATLAS_PAIRING_ORIGIN=http://192.168.1.15:8765
ATLAS_LOGIN_MODE=optional

# For a future trusted HTTPS deployment, e.g. https://atlas.example.org:
# ATLAS_PUBLIC_ORIGIN=https://YOUR-HTTPS-DOMAIN
# ATLAS_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
# ATLAS_GOOGLE_CLIENT_SECRET=SET_THIS_IN_SERVER_SECRET_MANAGER_NOT_IN_GITHUB
# ATLAS_LOGIN_MODE=google
